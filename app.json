{
  "expo": {
    "name": "nimou",
    "slug": "beikost-begleiter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.beikostbegleiter.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.beikostbegleiter.app",
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Die Kamera wird nur zum Scannen von Barcodes im Supermarkt genutzt. Es werden keine Fotos gespeichert.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6EE"
        }
      ]
    ],
    "scheme": "beikost",
    "experiments": {
      "typedRoutes": true
    }
  }
}
