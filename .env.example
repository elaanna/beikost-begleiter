# Kopieren nach .env.local und ausfüllen. Ohne Werte läuft die App lokal im Vorschau-Modus.

# Supabase (Projekt in Region eu-central-1 / Frankfurt anlegen)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat (öffentliche SDK-Schlüssel, nicht die Secret Keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# KI-Rezeptsuche (Supabase Edge Function rezept-assistent) einschalten
EXPO_PUBLIC_AI_ENABLED=
